<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Semanal - Licitaciones</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-slate-50 font-sans text-gray-800">

    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20">
                <div class="flex items-center">
                    <img src="image_c58d89.png" alt="Producción Técnica S.A.S." class="h-14 object-contain mr-4">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">Dashboard Ejecutivo de Licitaciones</h1>
                        <p class="text-sm text-gray-500">Producción Técnica S.A.S. | Semana: 15/mayo/2026</p>
                    </div>
                </div>
                <div class="flex items-center text-sm font-medium text-gray-600 bg-gray-100 px-4 py-2 rounded-lg">
                    <i class="fa-solid fa-user-tie mr-2 text-blue-600"></i> Elaborado por: Sebastián Sáenz J.
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
            <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-gray-100 flex items-center p-5">
                <div class="p-3 rounded-full bg-blue-100 text-blue-600 mr-4">
                    <i class="fa-solid fa-file-contract fa-lg"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 truncate">Total Propuestas (Pipeline)</p>
                    <p class="text-2xl font-bold text-gray-900">10</p>
                </div>
            </div>
            <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-gray-100 flex items-center p-5">
                <div class="p-3 rounded-full bg-green-100 text-green-600 mr-4">
                    <i class="fa-solid fa-money-bill-trend-up fa-lg"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 truncate">Valor Pipeline (COP)</p>
                    <p class="text-2xl font-bold text-gray-900">$17.924 M</p>
                </div>
            </div>
            <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-gray-100 flex items-center p-5">
                <div class="p-3 rounded-full bg-yellow-100 text-yellow-600 mr-4">
                    <i class="fa-solid fa-clock fa-lg"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 truncate">En Preparación</p>
                    <p class="text-2xl font-bold text-gray-900">5</p>
                </div>
            </div>
            <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-gray-100 flex items-center p-5">
                <div class="p-3 rounded-full bg-red-100 text-red-600 mr-4">
                    <i class="fa-solid fa-circle-xmark fa-lg"></i>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500 truncate">Stand By / Pérdidas</p>
                    <p class="text-2xl font-bold text-gray-900">2</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <div class="bg-white shadow-sm rounded-xl border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-slate-50 rounded-t-xl flex justify-between items-center">
                    <h2 class="text-lg font-bold text-slate-800">
                        <i class="fa-solid fa-spinner text-yellow-500 mr-2"></i> Propuestas en Preparación / Trámite
                    </h2>
                    <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded">Prioridad Alta</span>
                </div>
                <div class="p-6">
                    <ul class="divide-y divide-gray-200">
                        <li class="py-4">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-md font-bold text-gray-900">CORFERIAS INVERSIONES SAS</h3>
                                    <p class="text-sm text-gray-500">Evento Más Talante CEMA — Producción técnica integral</p>
                                    <div class="mt-2 flex items-center text-sm text-gray-500">
                                        <i class="fa-regular fa-calendar mr-1.5"></i> Cierre: 11/09/2026
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-md font-bold text-blue-600">$773.500.000</p>
                                    <span class="inline-flex items-center mt-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                        En preparación (75%)
                                    </span>
                                </div>
                            </div>
                        </li>
                        <li class="py-4">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-md font-bold text-gray-900">CORFERIAS</h3>
                                    <p class="text-sm text-gray-500">Feria SOFA 2026 — Producción técnica integral</p>
                                    <div class="mt-2 flex items-center text-sm text-gray-500">
                                        <i class="fa-regular fa-calendar mr-1.5"></i> Cierre: 14/09/2026
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-md font-bold text-blue-600">$284.886.000</p>
                                    <span class="inline-flex items-center mt-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                        En preparación
                                    </span>
                                </div>
                            </div>
                        </li>
                        <li class="py-4">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="text-md font-bold text-gray-900">Concejo Municipal de Cajicá</h3>
                                    <p class="text-sm text-gray-500">Bienestar social funcionarios (Logística integral)</p>
                                    <div class="mt-2 flex items-center text-sm text-gray-500">
                                        <i class="fa-solid fa-list-check mr-1.5"></i> Pendiente: Gestionar perfiles y RNT
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-md font-bold text-blue-600">$77.500.000</p>
                                    <span class="inline-flex items-center mt-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                        Saneamiento Doc. (65%)
                                    </span>
                                </div>
                            </div>
                        </li>
                    </ul>
                    
                    <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
                        <p class="text-sm text-gray-600">
                            <strong>Nota:</strong> Actualmente no hay propuestas en estado "Presentada". El foco de la semana es cerrar la documentación técnica y financiera (ROE y ROI) para los procesos de Corferias.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-white shadow-sm rounded-xl border border-gray-200">
                <div class="px-6 py-4 border-b border-gray-200 bg-slate-50 rounded-t-xl flex justify-between items-center">
                    <h2 class="text-lg font-bold text-slate-800">
                        <i class="fa-solid fa-ban text-red-500 mr-2"></i> Propuestas Descartadas / Perdidas
                    </h2>
                </div>
                <div class="p-6">
                    <ul class="divide-y divide-gray-200">
                        <li class="py-4">
                            <div class="flex justify-between items-start">
                                <div class="pr-4">
                                    <h3 class="text-md font-bold text-gray-900">Centro Cultural Bacatá</h3>
                                    <p class="text-sm text-gray-500">Servicios técnicos especializados para eventos culturales</p>
                                    <div class="mt-3 bg-red-50 border-l-4 border-red-400 p-3 rounded-r-md">
                                        <p class="text-xs text-red-700">
                                            <strong>Motivo / Observación:</strong> Limitación de bodega en Bogotá (-10 pts). 
                                        </p>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <p class="text-md font-bold text-gray-400">$895.000.000</p>
                                    <span class="inline-flex items-center mt-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Pérdida (0%)
                                    </span>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </main>

</body>
</html>
